# Copy to .env.staging on the staging host. Do not reuse production data stores.
NODE_ENV=production
DATABASE_URL=postgresql://postgres:STAGING_PASSWORD@postgres:5432/tuvansa_ai
INTERNAL_API_KEY=replace-with-staging-ai-internal-key
LOCAL_PRODUCTS_INTERNAL_API_KEY=replace-with-staging-ai-internal-key
CORE_BACKEND_ASSISTANT_API_KEY=replace-with-staging-assistant-key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_OCR_MODEL=gpt-6-luna

# The compose file supplies Redis, storage path, API port and core URL.
PINECONE_API_KEY=
PINECONE_CATALOG_V2_INDEX=proscai-catalog-v2
PINECONE_CATALOG_VARIANTS_NAMESPACE=catalog-variants-v1
PINECONE_LOCAL_PRODUCTS_NAMESPACE=local-products-staging
VOYAGEAI_API_KEY=
VOYAGE_CATALOG_V2_MODEL=voyage-4-large
VOYAGE_CATALOG_V2_DIMENSION=1024
ERP_PRODUCTS_API_KEY=replace-with-staging-erp-internal-key
# Compose sets ERP_PRODUCTS_BASE_URL to the private read-only ERP instance.
URL_MYSQL=
USER_MYSQL=
PASSWORD_MYSQL=
DB_MYSQL=
