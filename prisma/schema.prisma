generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AiJobStatus {
  queued
  processing
  completed
  failed
  cancelled
  needs_review
}

enum AiJobType {
  quote_text_extraction
  quote_document_extraction
  quoted_excel_extraction
  supplier_quote_extraction
  semantic_search
  vector_catalog_sync
  catalog_search_evaluation
  technical_data_suggestion
  missing_product_normalization
  quote_catalog_code_suggestion
  party_data_extraction
}

model AiJob {
  id             String       @id @default(uuid())
  type           AiJobType
  status         AiJobStatus  @default(queued)
  progress       Int          @default(0)
  idempotencyKey String       @unique @map("idempotency_key")
  inputHash      String       @map("input_hash")
  inputJson      Json         @map("input_json")
  resultJson     Json?        @map("result_json")
  errorCode      String?      @map("error_code")
  errorMessage   String?      @map("error_message")
  promptVersion  String?      @map("prompt_version")
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  startedAt      DateTime?    @map("started_at")
  completedAt    DateTime?    @map("completed_at")
  runs           AiJobRun[]

  @@index([status, createdAt])
  @@index([type, createdAt])
  @@map("ai_jobs")
}

model AiJobRun {
  id            String   @id @default(uuid())
  jobId         String   @map("job_id")
  attempt       Int
  provider      String
  model         String
  promptVersion String?  @map("prompt_version")
  inputTokens   Int?     @map("input_tokens")
  outputTokens  Int?     @map("output_tokens")
  latencyMs     Int?     @map("latency_ms")
  succeeded     Boolean
  errorCode     String?  @map("error_code")
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")
  job           AiJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, attempt])
  @@map("ai_job_runs")
}

model SatCatalogEntry {
  code         String    @id @db.VarChar(8)
  description  String    @db.Text
  similarWords String    @default("") @map("similar_words") @db.Text
  searchText   String    @map("search_text") @db.Text
  preferred    Boolean   @default(false)
  validFrom    DateTime? @map("valid_from") @db.Timestamp(3)
  validTo      DateTime? @map("valid_to") @db.Timestamp(3)

  @@index([preferred], map: "sat_catalog_entries_preferred_idx")
  @@map("sat_catalog_entries")
}

model SatCatalogImport {
  id                 Boolean   @id @default(true)
  sourceSha256       String    @map("source_sha256") @db.VarChar(64)
  catalogPublishedAt DateTime? @map("catalog_published_at") @db.Timestamp(3)
  importedAt         DateTime  @default(now()) @map("imported_at") @db.Timestamp(3)
  rowCount           Int       @map("row_count")

  @@map("sat_catalog_imports")
}
